# Abhaengigkeiten und Build
node_modules/
dist/

# Laufzeitdaten — vollstaendig regenerierbar, gehoeren nicht in die Versionsverwaltung:
#   Gelaende   -> npm run gelaende:heinerfest
#   Konten     -> npm run seed
#   Abnahme    -> npm run abnahme
data/gelaende/
data/gelaende-abgelegt/
data/cache/
data/projekte/
data/abnahme/
# OSM-Ortsauszug: 343 MB Fremddaten mit eigener Herkunft und Pruefsumme.
# Gehoert nicht in die Versionsverwaltung, sondern wird geholt mit:
#   node scripts/osm-auszug-holen.ts
data/osm-auszug/
data/organisationen.json
data/nutzer.json
data/mitgliedschaften.json
data/benachrichtigungen.json
data/objekttypen-eigen.json
data/server.log

# Geheimnisse
.env
.env.*

