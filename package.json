{
  "name": "heinerfest",
  "private": true,
  "version": "1.0.0",
  "description": "EventPlan3D — KI-gestuetzte 3D-Planungsplattform fuer Grossveranstaltungen (Pilot: Heinerfest Darmstadt)",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.ts",
    "seed": "node scripts/seed.ts",
    "abnahme": "node scripts/abnahme.ts",
    "gelaende:heinerfest": "node scripts/gelaende-heinerfest.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/**/*.test.ts shared/**/*.test.ts",
    "ports:frei": "node scripts/ports-freigeben.ts",
    "predev": "node scripts/ports-freigeben.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.3",
    "fflate": "^0.8.2",
    "jpeg-js": "^0.4.4",
    "pdfkit": "^0.15.2",
    "polygon-clipping": "^0.15.7",
    "proj4": "^2.15.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.9",
    "@types/proj4": "^2.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "cesium": "^1.126.0",
    "concurrently": "^9.1.2",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-cesium": "^1.2.23",
    "zustand": "^5.0.2"
  }
}
